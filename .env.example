# PostgreSQL. Keep the real values only in .env on the server.
POSTGRES_USER=linkens_sphere
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=linkens_sphere
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Discord bot
DISCORD_TOKEN=
GUILD_ID=
CATEGORY_ID=
NEW_USER_ROLE_ID=
LEAGUE_PARTICIPANT_ROLE_ID=
SCREEN_CHANNEL_ID=
CLOSE_CHANNEL_ID=
CLOSE_HOST_ROLE_ID=
BOOSTY_GRANT_ROLE_ID=
# Comma-separated Discord IDs of all seven rune roles. These roles are shown
# on player profiles; every rune except Water can select a profile background.
BOOSTY_SUBSCRIPTION_ROLE_IDS=
SEASONAL_ALLOWED_ROLE_IDS=
LOG_WEBHOOK_URL=
PROFILE_ADMIN_ID=
STEAM_API_KEY=
STRATZ_TOKEN=
SHEET_URL=
GOOGLE_CREDENTIALS_PATH=/run/secrets/google-credentials.json

# Activity rules used by the bot
ACTIVITY_CHECK_USE_WINS=true
ACTIVITY_MAIN_REQUIRED=10
ACTIVITY_SIDE_REQUIRED=5
ACTIVITY_TOTAL_REQUIRED=20
DEBUG=false

# Website and Discord OAuth
# Production: PUBLIC_BASE_URL=https://lsesports.ru and SITE_DOMAIN=lsesports.ru
PUBLIC_BASE_URL=http://localhost:3000
SITE_DOMAIN=lsesports.ru
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Separate password that enables organizer mode for an authenticated player.
# Use at least 12 characters and keep the real value only in the server .env.
ORGANIZER_PASSWORD=
SITE_BIND_ADDRESS=127.0.0.1
SITE_PORT=3000
DATABASE_POOL_SIZE=10
WEBSITE_NOTIFICATIONS_ENABLED=true
# Private participant chats for season rounds are created in this category.
LIVE_EVENTS_CATEGORY_ID=1211809315464159242

# Compendium. A separate long secret is recommended; when omitted, the existing
# server-side Discord bot token is used without sending it to the browser.
# Inside Docker the bot reaches the site by its service name.
COMPENDIUM_SCHEDULER_SECRET=
COMPENDIUM_SITE_URL=http://site:3000
# Optional: raises OpenDota request limits. Never expose this key to the browser.
OPENDOTA_API_KEY=
