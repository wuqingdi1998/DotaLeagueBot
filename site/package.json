    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
