{
  "name": "@linkens-sphere/site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-compendium-test.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:layout": "vitest run tests/october-layout-fixtures.test.tsx tests/compendium-parity-fixtures.test.tsx && node scripts/check-october-layout.mjs && node scripts/check-clan-activity.mjs && node scripts/check-final-race-preview.mjs && node scripts/build-compendium-test.mjs && node scripts/check-compendium-test.mjs && node scripts/check-compendium-parity.mjs && node scripts/check-league-backdrops.mjs",
    "test:parity:production": "vitest run tests/compendium-parity-fixtures.test.tsx && node scripts/check-compendium-parity.mjs --production",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:layout && npm run build && npm run test:parity:production"
  },
  "dependencies": {
    "jose": "^6.1.2",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "playwright": "^1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.2.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  },
  "type": "module"
}
